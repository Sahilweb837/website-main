{
    "name": "netcoder/laravel-backend",
    "type": "project",
    "description": "Production Laravel REST API & Main Admin LMS Backend for Netcoder Technology",
    "keywords": ["framework", "laravel", "lms", "rest-api", "edtech"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^10.0",
        "laravel/sanctum": "^3.3|^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 server.php",
        "start": "php -S 127.0.0.1:8000 server.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
