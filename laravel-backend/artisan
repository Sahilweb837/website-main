#!/usr/bin/env php
<?php

/**
 * Netcoder Technology - Laravel Artisan CLI Emulator
 * Dual-Mode Standalone Artisan runner for Windows & Linux
 */

define('LARAVEL_START', microtime(true));

$args = array_slice($argv, 1);
$command = $args[0] ?? 'list';

$host = '127.0.0.1';
$port = '8000';

// Parse options like --host and --port
foreach ($args as $arg) {
    if (str_starts_with($arg, '--port=')) {
        $port = substr($arg, 7);
    }
    if (str_starts_with($arg, '--host=')) {
        $host = substr($arg, 7);
    }
}

if ($command === 'serve' || $command === 'serce') {
    echo "\n";
    echo "\033[32m   _   _      _                 _           \033[0m\n";
    echo "\033[32m  | \ | | ___| |_ ___ ___   __| | ___ _ __  \033[0m\n";
    echo "\033[32m  |  \| |/ _ \ __/ __/ _ \ / _` |/ _ \ '__| \033[0m\n";
    echo "\033[32m  | |\  |  __/ || (_| (_) | (_| |  __/ |    \033[0m\n";
    echo "\033[32m  |_| \_|\___|\__\___\___/ \__,_|\___|_|    \033[0m\n";
    echo "\n";
    echo "  \033[1;37mNetcoder LMS Backend & REST API Server (Laravel Dual-Mode)\033[0m\n";
    echo "  ---------------------------------------------------------\n";
    echo "  \033[32mINFO\033[0m Server running on \033[1;34m[http://{$host}:{$port}]\033[0m\n";
    echo "  \033[32mINFO\033[0m Admin Dashboard:  \033[1;33mhttp://{$host}:{$port}/admin\033[0m (admin / admin123)\n";
    echo "  \033[32mINFO\033[0m Next.js REST API: \033[1;36mhttp://{$host}:{$port}/api/courses\033[0m\n\n";
    echo "  Press \033[1mCtrl+C\033[0m to stop the server.\n\n";

    $serverScript = __DIR__ . DIRECTORY_SEPARATOR . 'server.php';
    passthru("php -S {$host}:{$port} \"{$serverScript}\"");
    exit(0);
}

if ($command === 'route:list') {
    echo "\n\033[1mNetcoder LMS Backend Routes:\033[0m\n";
    echo "+---------+-------------------------+-----------------------------------------+\n";
    echo "| Method  | URI                     | Action / Description                    |\n";
    echo "+---------+-------------------------+-----------------------------------------+\n";
    echo "| GET     | /admin                  | Admin Dashboard (Auth Guarded)          |\n";
    echo "| GET|POST| /admin/login            | Admin Authentication (admin/admin123)   |\n";
    echo "| GET     | /admin/logout           | Admin Session Logout                    |\n";
    echo "| GET     | /api/courses            | List LMS Courses (Filter by cat, q)     |\n";
    echo "| POST    | /api/courses            | Upload New LMS Course                   |\n";
    echo "| POST    | /api/courses/update     | Update Existing Course Details          |\n";
    echo "| DELETE  | /api/courses            | Delete Course from Catalog              |\n";
    echo "| GET     | /api/admin/stats        | Live Platform Revenue & DRM Stats       |\n";
    echo "| GET|POST| /api/lms/students       | Student Enrollments & Fee Registry      |\n";
    echo "| POST    | /api/auth/student-login | Student OTP/Password Authentication     |\n";
    echo "+---------+-------------------------+-----------------------------------------+\n\n";
    exit(0);
}

if ($command === 'migrate' || $command === 'db:seed') {
    require __DIR__ . '/server.php';
    echo "\033[32mINFO\033[0m Database storage synchronized with seed catalog.\n";
    exit(0);
}

// Default help/list
echo "\n\033[33mNetcoder Technology Laravel Artisan CLI\033[0m (v11.x Standalone)\n\n";
